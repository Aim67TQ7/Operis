# Copy to deploy/staging/.env on the approved staging host only; this local file is ignored by Git.
# Use the exact checked-out source commit as the image tag.
OPERIS_RELEASE=
# Confirm DNS and availability before setting.
OPERIS_API_HOSTNAME=
# Approved provider project URL and publishable key only. Never use a service-role/secret key.
OPERIS_SUPABASE_URL=
OPERIS_SUPABASE_PUBLISHABLE_KEY=
# External reverse-proxy network name on the approved staging host.
OPERIS_INGRESS_NETWORK=
