# Copy to deploy/pete/.env on Pete only; this local file is ignored by Git.
# Use the exact checked-out source commit as the image tag.
OPERIS_RELEASE=
# Proposed: operis-api.gp3.app. Confirm DNS and availability before setting.
OPERIS_API_HOSTNAME=
# ZODA publishable key only. Never use a service-role/secret key.
OPERIS_SUPABASE_PUBLISHABLE_KEY=
